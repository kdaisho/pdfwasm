DATABASE_URL=postgres://pdfwasm:pdfwasm@localhost:5434/pdfwasm
PDF_STORAGE_PATH=./storage/pdfs
PORT=3001
NODE_ENV=development
# Passkeys (WebAuthn relying party). RP_ID is the bare domain passkeys are
# bound to; RP_ORIGIN is the web app's origin exactly as the browser reports
# it (scheme + host + port). Changing RP_ID in production orphans every
# existing passkey. Checked at startup. KDA-66.
RP_ID=localhost
RP_NAME=PDF Viewer
RP_ORIGIN=http://localhost:5173
# AI split suggestions (Edit Mode → "Suggest splits"). Either key enables the
# feature; with both set, Jev wins. The server boots fine with neither — the
# endpoint just reports 503. KDA-53, KDA-63.
# OpenRouter — serves TypeSafe's Jev decision model ("typesafe/jev-latest")
# through its Decisions API. Preferred provider. Key: openrouter.ai/keys
OPENROUTER_API_KEY=
# Anthropic (claude-haiku-4-5) — fallback until Jev clears its accuracy benchmark.
ANTHROPIC_API_KEY=
# Pin one provider regardless of which keys are set: openrouter | anthropic
SUGGEST_PROVIDER=
